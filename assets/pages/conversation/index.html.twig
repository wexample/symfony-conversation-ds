{%- extends '@front/layouts/private/layout.html.twig' -%}

{#- The conversations of the person signed in, the one that last spoke first,
    what the application pins before them — its agent —; one opened goes on
    where the list is held (`self`): the dock's panel, or this page. -#}
{%- block page_body -%}
    <div class="conversation-screen" data-target-embedded="self">
        {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/conversation-list', {
            items: conversation_items,
            empty: '@page::empty'|trans,
        }) }}
    </div>
{%- endblock -%}
