{
  "name": "wexample/symfony-conversation-ds",
  "version": "1.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyConversationDs\\": "src/"
    }
  },
  "description": "Design-system screens for symfony-conversation",
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-conversation": ">=1.0.1",
    "wexample/symfony-design-system": ">=43.0.0",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-loader": ">=27.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
